{
  "name": "asyncthink",
  "version": "2.7.2",
  "description": "MCP server: sequential thinking + parallel competitor council + threaded delegation to subordinate model CLIs (read-only)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "asyncthink": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/*.js && mkdir -p dist/adapters/manifests && cp src/adapters/manifests/*.json dist/adapters/manifests/",
    "prepare": "git config core.hooksPath .githooks && npm run build",
    "watch": "tsc --watch",
    "test": "vitest run --coverage",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "audit:supply-chain": "node scripts/audit-supply-chain.mjs > /dev/null",
    "audit:supply-chain:report": "node scripts/audit-supply-chain.mjs",
    "audit:supply-chain:refresh": "node scripts/refresh-ioc.mjs",
    "reinstall": "bash scripts/reinstall.sh",
    "cache:status": "bash scripts/cache-status.sh",
    "cache:prune": "bash scripts/cache-prune.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4.0.15",
    "typescript": "^5.3.3",
    "vitest": "^4.0.15"
  }
}
