# AsyncThink Environment Configuration
# Copy this file to .env and fill in your values

# Gemini API Key (required for Gemini workers)
# GEMINI_API_KEY=your-gemini-api-key-here

# Optional: AsyncThink Configuration
# These can also be set via the configuration tool

# Default number of sub-queries per research task (1-3, max 3)
# ASYNCTHINK_DEFAULT_WORKERS=3

# Worker timeout in milliseconds (default: 120000 = 2 minutes)
# ASYNCTHINK_TIMEOUT_MS=120000

# Log level (debug, info, warn, error)
# ASYNCTHINK_LOG_LEVEL=info
